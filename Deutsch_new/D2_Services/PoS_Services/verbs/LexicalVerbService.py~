# "Полнозначный" глагол по-английски будет "full verb" или "lexical verb".
class LexicalVerbService(VerbInfinitiveFinder):
    def __init__(self):
        # Передаём в конструктор базового класса список словарей с формами глаголов
        super().__init__(lexical_verbs)

    def get_verb_infinitive(self, token, morph):
        result = super().get_verb_infinitive(token, morph)
        return result


