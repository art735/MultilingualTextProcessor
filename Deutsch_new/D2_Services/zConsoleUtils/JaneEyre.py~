import FileContentsReader
import Tokenizer

filename = r'E:\Languages\English\SVN repo\Python software\MultilingualTextProcessor\resources\English\jane-eyre.txt'

text = FileContentsReader.get_file_text(filename)
text = text.replace('–', ' – ')
text = text.replace('-', ' - ')
text = text.replace('—', ' — ')

tokens = Tokenizer.tokenize(text, considerNumberAsToken=False, strip_apostrophe=True)

unique_tokens = set(tokens)
print(len(unique_tokens))

