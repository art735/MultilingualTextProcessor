def aspirate_transcriptions_in_all_decks():
    transcriptionsInAnkiAspirator = TranscriptionsInAnkiAspirator()
    all_deck_names = AnkiConnectService().get_all_deck_names()
    for deck_name in all_deck_names:
        if deck_name not in ['Italian']:
            transcriptionsInAnkiAspirator.aspirate(deck_name)
    return

