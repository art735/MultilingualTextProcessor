def overwrite_transcriptions_in_GERMAN_decks():
    transcriptionsInAnkiOverwriter = TranscriptionsInAnkiOverwriter()
    all_deck_names = AnkiConnectService().get_all_deck_names()
    for deck_name in all_deck_names:
        if not deck_name.startswith(('English', 'Italian')):
            # print(deck_name)
            transcriptionsInAnkiOverwriter.overwrite(deck_name, 'de')

    return

