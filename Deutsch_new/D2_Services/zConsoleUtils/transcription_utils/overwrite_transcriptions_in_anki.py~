import beautiful_soup_helper

from AnkiConnectService import AnkiConnectService
from T0_TranscriptionAggregatedProcessor import T0_TranscriptionAggregatedProcessor


# Добавляет задним числом транскрипциям слов различные доп. символы: аспирация, ассимиляция,
# маркировка альвеоляров и т. д.
class TranscriptionsInAnkiOverwriter:
    def __init__(self):
        self.ankiConnectService = AnkiConnectService()
        self.t0_TranscriptionAggregatedProcessor = T0_TranscriptionAggregatedProcessor()

    def overwrite(self, deck_name, lang):
        notes = self.ankiConnectService.get_notes_by_deck_name(deck_name)
        counter = 1
        # цикл по всем карточкам
        for note in notes:
            if 'Transcription' not in note['fields']:
                continue

            current_transcription = note['fields']['Transcription']['value']

            # Формат содержимого поля 'Transcription':
            # - plain text (в большинстве случаев), если в поле 'Transcription' отсутствует форматирование;
            # - html-код, если в поле 'Transcription' присутствует форматирование.
            if beautiful_soup_helper.is_html(current_transcription):
                new_transcription = self._overwrite_in_html(current_transcription, lang)
            else:
                new_transcription = self.t0_TranscriptionAggregatedProcessor.process(current_transcription, lang)

            if current_transcription != new_transcription:
                print(f'{current_transcription}\n-->\n{new_transcription}')
                # 2-й параметр - это словарь полей карточки, которые нужно обновить {название поля: новое значение поля}
                self.ankiConnectService.update_note_in_anki(note, {'Transcription': new_transcription})
                print(f'note {counter} updated\n')
                counter += 1
        return

    # Не расформировывать данный метод, т. к. он нужен, как минимум, для тестирования добавления аспирации в HTML.
    def _overwrite_in_html(self, html_str, lang):
        soup = beautiful_soup_helper.getBs(html_str)
        self._process_element_recursively(soup, lang)
        new_transcription = beautiful_soup_helper.soup_to_str(soup)
        return new_transcription

    # Рекурсивный метод наподобие TextReplacerInOdtFile.replace_in_paragraph(...)
    # Рекурсивно обрабатывает весь текст в HTML-элементе, включая вложенные теги.
    def _process_element_recursively(self, element, lang):
        # Обрабатываем смешанный контент (текст и теги)
        for content in element.children:
            if isinstance(content, str):  # Если это текстовый узел
                processed_text = self.t0_TranscriptionAggregatedProcessor.process(content, lang)
                content.replace_with(processed_text)
            else:  # Если это тег
                self._process_element_recursively(content, lang)


