from nltk import WordNetLemmatizer

import FileContentsReader
import Tokenizer

filename = r'/resources/English/jane-eyre.txt'

text = FileContentsReader.get_file_text(filename)
text = text.replace('–', ' – ')
text = text.replace('-', ' - ')
text = text.replace('—', ' — ')

tokens = Tokenizer.tokenize(text, considerNumberAsToken=False, strip_apostrophe=True)

unique_tokens = set(tokens)
print(len(unique_tokens))

# for token in unique_tokens:
#     print(token)

####################

# Create a lemmatizer
lemmatizer = WordNetLemmatizer()

# # Your list of tokens
# tokens = ["cast", "bustle", ...]

# Lemmatize each token
lemmas = [lemmatizer.lemmatize(token) for token in unique_tokens]

# Find unique lemmas
unique_lemmas = set(lemmas)

print(len(unique_lemmas))  # Number of unique lemmas

