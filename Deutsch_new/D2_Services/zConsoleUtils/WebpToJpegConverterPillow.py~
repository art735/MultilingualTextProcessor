import os
from PIL import Image

def convert_webp_to_jpeg(input_folder, output_folder):
    # Убедитесь, что папка для сохранения существует
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)

    # Перебор всех файлов .webp в папке
    for file in os.listdir(input_folder):
        if file.endswith(".webp") or file.endswith(".png"):
            input_path = os.path.join(input_folder, file)
            output_path = os.path.join(output_folder, os.path.splitext(file)[0] + ".jpeg")

            try:
                # Открытие .webp файла и конвертация в .jpeg
                with Image.open(input_path) as img:
                    rgb_img = img.convert("RGB")  # Конвертация в RGB для сохранения в JPEG
                    rgb_img.save(output_path, "JPEG")
                print(f"Успешно конвертировано: {file} -> {output_path}")
            except Exception as e:
                print(f"Ошибка при конвертации {file}: {e}")

# Указать папки для входящих и исходящих файлов
input_folder = r"C:\Users\user\Desktop\Football\Спартак\Спартак"  # Замените на путь к папке с .webp
output_folder = r"C:\Users\user\Desktop\Football\Спартак\Спартак (jpeg)"  # Замените на папку для сохранения .jpeg

convert_webp_to_jpeg(input_folder, output_folder)
