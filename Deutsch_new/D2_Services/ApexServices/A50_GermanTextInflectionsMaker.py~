    def _validate_all_words_are_present_in_vocabulary(self, input_text):
        results_dict = {}
        tuples = self.spaCyGermanEngineWrapper.get_doc_object_tuples(input_text)
        for token, lemma, pos, morph in tuples:
            # Переиспользуем метод из модуля "первого юс кейса" A10_NewLemmasFinder
            processed_lemma = self.a10_NewLemmasFinder.get_single_lemma(token, lemma, pos, morph)
            # if self.spaCyPosResolver.is_noun(pos):
            #     gender = self.morphologyParser.parse(morph, "Gender")
            #     lemma = self.germanDefiniteArticleService.add_definite_article_to_sg_nom_lemma(lemma, gender)

            # TODO: сделать метод is_word_in_vocabulary в OOWriterService
            # is_absent_from_vocabulary = not self.germanExcelService.is_word_in_vocabulary(processed_lemma)
            is_absent_from_vocabulary = not self.germanOOWriterService.is_word_in_vocabulary(processed_lemma)
            is_absent_from_results_dict = processed_lemma not in results_dict

            if is_absent_from_vocabulary and is_absent_from_results_dict:
                results_dict[processed_lemma] = f"Word '{processed_lemma}' is absent from vocabulary! Please, add it!"

        return results_dict.values()

    def _process_sentence(self, sentence):
        # key - token; value - pair/triplet of nouns with translation and grammar hint
        # sentence_results_dict = {}

        sentence_results1 = list()
        sentence_results2 = list()
        sentence_results3 = list()

        tuples = self.spaCyGermanEngineWrapper.get_doc_object_tuples(sentence)

        # lemma специально сделана не как поле класса (без слова self), т. к. она не всегда правильно определяется.
        # Пользуемся вариантом "обработанной леммы" от модуля A10_NewLemmasFinder.get_single_lemma(...)
        for self.token, self.lemma, self.pos, self.morph in tuples:
            if self.is_token_not_in_its_initial_dictionary_form():
                self.processed_lemma = self.a10_NewLemmasFinder.get_single_lemma(self.token, self.lemma, self.pos, self.morph)

                result1 = ''
                result2 = ''
                # если слово является собственным (proper) или нарицательным (common) существительным
                if self.spaCyPosResolver.is_noun(self.pos):
                    result1, result2 = self._process_noun()
                    # Непосредственно в одной ячейке с немецким предложением храним морфологию только существительных.
                    sentence_results3.append(result2)

                # spaCy не различает сильное, слабое и смешанное склонение прилагательных; здесь представлять интерес могут
                # степени сравнения прилагательных: Degree={Pos|Comp|Sup}
                # elif self.spaCyPosResolver.is_adjective(self.pos):


                # pos = 'AUX' - это модальные глаголы; pos = 'VERB' - это обычные глаголы
                elif self.spaCyPosResolver.is_aux_or_verb(self.pos):
                    result1, result2 = self._process_verb()

                    # print(f"pos = '{self.pos}'")
                    # print(f"morph = '{self.morph}'")
                    # print('**************')

                # местоимения и определители собраны в одном и том же Excel-листе 'Articles & Pronouns'
                elif self.spaCyPosResolver.is_pronoun(self.morph) or self.spaCyPosResolver.is_determiner(self.pos):
                    result1, result2 = self._process_pronoun_and_determiner()
                    # sentence_results1.append(result1)
                    # sentence_results2.append(result2)

                    # print(f"pos = '{self.pos}'")
                    # print(f"morph = '{self.morph}'")
                    # print('**************')

                # код, идущий после проверок на соответствие частям речи
                sentence_results1.append(result1)
                sentence_results2.append(result2)


            # ('ἐλέησόν', 'ἐλεέω', 'VERB', Aspect=Perf|Mood=Imp|Number=Sing|Person=2|Tense=Past|VerbForm=Fin|Voice=Act)
            # if self.spaCyPosResolver.is_verb(self.pos):
            #     print(self.pos)
            #     print(self.morph)
        # end of loop

        # Преобразовываем списки с результатами в строковую форму
        output1 = "\n".join([item for item in sentence_results1 if item])
        output2 = "\n".join([item for item in sentence_results2 if item])

        # добавляем строку с неизвестным переводом
        sentence_unknown_words, sentence_transcription = GermanTextTranscriber.transcribe_single_sentence(sentence)
        sentence_translation = '???'
        sentence_result = '|'.join([sentence, sentence_transcription, sentence_translation])

        # В sentence_results2 хранятся морф. формы, которые будут находиться с предложением в РАЗНЫХ строках.
        # В sentence_results3 хранятся морф. формы, которые будут находиться с предложением в ОДНОЙ И ТОЙ ЖЕ строке.
        # sentence_results2_copy = list(sentence_results2)
        sentence_results3.append(sentence_result)

        # Делаем merge строк в пределах каждого столбца (в механике OO Writer) и объединяем их с помощью pipe
        # в одну широкую строку, содержащую морф. формы + предложение, к которому они относятся
        col1_results = []
        col2_results = []
        col3_results = []
        for line in sentence_results3:
            pieces = line.split("|")
            col1_results.append(pieces[0])
            col2_results.append(pieces[1])
            col3_results.append(pieces[2])

        # В первом столбце между иностранными словами должно быть в среднем на 1 newline больше, чтобы они стояли ровно
        # напротив своих переводов, под каждым из которых подписан ещё и grammar_hint.
        col1_results_output = (OO_WRITER_STRIPES_DELIMITER + '^^^').join(col1_results)
        col2_results_output = (OO_WRITER_STRIPES_DELIMITER + '^^^').join(col2_results)
        col3_results_output = OO_WRITER_STRIPES_DELIMITER.join(col3_results)
        output3 = "|".join([col1_results_output, col2_results_output, col3_results_output])

        # output2 = "\n".join([output1, output2, output3])

        return output1, output2, output3

    def is_token_not_in_its_initial_dictionary_form(self):
        # Берём в дальнейшую работу только те глаголы, которые имеют конечную форму (т. е. не инфинитивы)
        # todo: подходит ли данная проверка для отглагольных форм типа Partizip I и Partizip II ???
        # Не-инфинитивная VerbForm включает в себя как минимум две категории:
        # 1) VerbForm=Fin - конечные (finite) формы глаголов
        # 2) VerbForm=Part - Partizip II (но не Partizip I, которое в spaCy считается как ADJ)
        if self.spaCyPosResolver.is_aux_or_verb(self.pos):
            result = self.spaCyPosResolver.is_verb_form_non_infinitive(self.morph)
        else:
            number = self.morphologyParser.parse(self.morph, "Number")
            case = self.morphologyParser.parse(self.morph, "Case")
            # если, например у сущ., имеется грамматическая категория числа
            # if number:
            result = number != NumberSpaCy.Sing.value or case != CaseSpaCy.Nom.value
            # если категория не указана (напр., die Leute)
            # else:
            #     result = case != CaseSpaCy.Nom.value
        return result

    def _process_noun(self):
        # В худшем случае в виде результатов вернём токен "как есть"
        result1 = self.token
        result2 = self.token

        # articled_token = self.nounDefiniteArticleService.add_definite_article_to_token(self.token, self.pos, self.morph)

        # if self.gender and self.number and self.case:
        # is_token_in_its_initial_dictionary_form = self.number == NumberSpaCy.Sing.value and self.case == CaseSpaCy.Nom.value
        # продолжаем обрабатывать токен только если он находится в отличном от начальной словарной формы состоянии
        # if self.is_token_not_in_its_initial_dictionary_form():
        token_grammar = self.nounGrammarConverter.convert(self.morph, ConversionMode.GENDER_NUMBER_CASE)
        # Одна и та же словоформа может представлять разные падежи!
        # Например, Ἰησοῦ - это и родительный, и звательный падеж!!!
        # Поэтому надо работать не просто с token, а с token_grammaticized и от него
        # тогда действительно можно требовать уникальности в 1-м столбце Excel-файла для морф. форм!
        # Ἰησοῦ (masc. sg. gen.)|ὁ Ἰησοῦς - τοῦ Ἰησοῦ|(nom. - gen.)
        # Ἰησοῦ (masc. sg. voc.)|ὁ Ἰησοῦς - Ἰησοῦ!|(nom. - voc.)
        self.token_grammaticized = f'{self.token} ({token_grammar})'

        # морф. форма обрабатываемого слова НЕ должна находиться среди:
        # 1) Excel-списка уже изученных ранее морф. форм
        # 2) словаря-поля класса text_results_dict, содержащего уже обработанные токены всех предыдущих предложений текста
        is_token_grammaticized_absent_from_excel = not self.germanExcelService.is_morph_form_present(
            self.token_grammaticized)
        is_token_grammaticized_absent_from_text_results_dict = self.token_grammaticized not in self.text_results_dict

        if is_token_grammaticized_absent_from_excel and is_token_grammaticized_absent_from_text_results_dict:
            # TODO: здесь идёт основная работа

            # Здесь именно self.lemma должна передаваться в метод, а не self.processed_lemma
            dashed_nouns_with_piped_pars_grammar = self.dashedArticledNounsComposer.compose(
                self.lemma, self.token, self.pos, self.morph)
            result1 = self.token_grammaticized + "|" + dashed_nouns_with_piped_pars_grammar
            # sentence_results1.append(result1)
            self.text_results_dict[self.token_grammaticized] = result1

            # TODO: продолжаем работу для формирования результата по 2-й категории
            # translation = self.ankiCardsService.get_word_translation(self.processed_lemma)
            DASH = '–' # todo: вынести в константу
            dashed_nouns = dashed_nouns_with_piped_pars_grammar.split('|')[0]
            articled_nouns = dashed_nouns.split(ExcelDaoGerman.SPACE_DASH_SPACE)
            transcriptions = []
            for articled_noun in articled_nouns:
                # # TODO: если получится со временем полностью переориентироваться на вычитку всех транкрипций из Excel-файла Попова,
                # #  т.к. они всем там должны быть, этот момент будет валидироваться и Excel-файл Попова в перспективе должен всё время пополняться!!!
                # transcription = self.germanOOWriterService.get_word_transcription(articled_noun)
                # # Если форма существительного совпадает с начальной формой, то его транскрипцию удастся найти в
                # # OO Writer-словарях, в противном случае пробуем искать транскрипцию слова в косвенном падеже в
                # # списках существительных у Попова.
                # if transcription:
                #     processed_transcription = self.germanNounService.add_definite_article_to_transcription(articled_noun, transcription)
                #     transcriptions.append(processed_transcription)
                # else:
                # TODO: ищем транскрипцию с помощью Попова
                transcription_from_popov = self.germanNounService.get_noun_transcription(articled_noun)
                transcriptions.append(transcription_from_popov)

            transcriptions_str = ExcelDaoGerman.SPACE_DASH_SPACE.join(transcriptions)

            articled_lemma = dashed_nouns_with_piped_pars_grammar.split(DASH)[0].strip()
            translation = self.germanOOWriterService.get_word_translation(articled_lemma)

            # строку вида 'ὁ ἄνθρωπος – τοῦ ἀνθρώπου|(nom. – gen.)' разбиваем по пайп и берём последний элемент
            dashed_nouns_with_piped_pars_grammar_pieces = dashed_nouns_with_piped_pars_grammar.split('|')
            parenthesized_grammar_hint = dashed_nouns_with_piped_pars_grammar_pieces[-1]
            translation_with_grammar_hint = "{0}^^^{1}".format(translation, parenthesized_grammar_hint)
            # строка вида 'ὁ ἄνθρωπος – τοῦ ἀνθρώπου|человек^^^(nom. – gen.)'
            result2 = '|'.join([dashed_nouns_with_piped_pars_grammar_pieces[0], transcriptions_str, translation_with_grammar_hint])

            # sentence_results2.append(result2)
        # else:
        #     if not self.gender:
        #         sentence_results1.append("<No 'gender (masc., fem., neut.)' info for token = > " + self.token)
        #     if not self.number:
        #         sentence_results1.append("No 'number (sg., dual, pl.)' info for token = > " + self.token)
        #     if not self.case:
        #         sentence_results1.append("No 'case (nom., gen., etc)' info for token = > " + self.token)

        return result1, result2

