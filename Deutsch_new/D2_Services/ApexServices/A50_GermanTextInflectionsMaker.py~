    def process_whole_text(self, input_text):

        # Проверяем все ли слова в тексте присутствуют в Excel-вокабуляре.
        # Если нет - возвращаем список слов, которые нужно добавить в вокабуляр
        # TODO: временно отключил валидацию, вернуть её назад!!!
        # missing_words = self._validate_all_words_are_present_in_vocabulary(input_text)
        # if missing_words:
        #     output = '\n'.join(missing_words)
        #     return output

        # Результаты работы метода условно делятся на две категории:
        # 1. Морф. формы всего текста для вставки их в Excel
        output_1_Excel_morph_forms_results = []
        # 2. Морф. формы каждого отдельного предложения вместе с самим этим предложением
        output_2_OO_Writer_morph_forms_results = []
        output_3_OO_Writer_morph_forms_with_sentence_results = []

        # Разбиваем текст на отдельные предложения (строки, библейские стихи)
        sentences = Utils.split_by(input_text, '\n')  # взять в дальнейшую работу только непустые строки

        for sentence in sentences:
            excel_morph_forms, oo_Writer_morph_forms, OO_Writer_morph_forms_with_sentence = self._process_sentence(sentence)
            output_1_Excel_morph_forms_results.append(excel_morph_forms)
            output_2_OO_Writer_morph_forms_results.append(oo_Writer_morph_forms)
            output_3_OO_Writer_morph_forms_with_sentence_results.append(OO_Writer_morph_forms_with_sentence)

        # Просеиваем результирующие списки от пустых результатов
        output_1_Excel_morph_forms_results = [o1 for o1 in output_1_Excel_morph_forms_results if o1]
        output_2_OO_Writer_morph_forms_results = [o2 for o2 in output_2_OO_Writer_morph_forms_results if o2]
        output_3_OO_Writer_morph_forms_with_sentence_results = [o3 for o3 in output_3_OO_Writer_morph_forms_with_sentence_results if o3]

        # 1. Вывод морф. форм всего текста для вставки их в Excel
        output_for_excel = 'Morph forms to add into Excel:\n'
        if len(output_1_Excel_morph_forms_results):
            output_for_excel += '\n'.join(output_1_Excel_morph_forms_results)
        else:
            output_for_excel += 'No new morph forms!'

        # 2. Вывод морф. форм всего текста для вставки их в OO Writer
        output_for_oo_writer = 'Morph forms to add into OO Writer:\n'
        if len(output_2_OO_Writer_morph_forms_results):
            output_for_oo_writer += '\n'.join(output_2_OO_Writer_morph_forms_results)
            output_for_oo_writer += '\n'

        if len(output_3_OO_Writer_morph_forms_with_sentence_results):
            output_for_oo_writer += '\n\n'.join(output_3_OO_Writer_morph_forms_with_sentence_results)
        # else:
        #     output_2_str += 'No new morph forms!'

        output = '\n\n'.join([output_for_excel, output_for_oo_writer])
        return output

