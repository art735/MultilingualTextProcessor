    def _process_pronoun_and_determiner(self):
        # В худшем случае в виде результатов вернём токен "как есть"
        result1 = self.token
        result2 = self.token

        is_token_absent_from_excel = not self.germanExcelService.is_morph_form_present(self.token)
        is_token_absent_from_text_results_dict = self.token not in self.text_results_dict

        if is_token_absent_from_excel and is_token_absent_from_text_results_dict:
            result1 = self.processed_lemma
            self.text_results_dict[self.processed_lemma] = result1

            pronoun_declension = self.germanPronounDeclensionService.get_pronoun_declension(self.processed_lemma)

            translation = self.germanOOWriterService.get_word_translation(self.processed_lemma)
            grammar_hint = '(склонение по падежам)'
            translation_with_grammar_hint = "{0}^^^{1}".format(translation, grammar_hint)

            result2 = pronoun_declension + "|" + translation_with_grammar_hint

        return result1, result2

    def _process_verb(self):
        infinitive = self.processed_lemma

        human_readable_grammar = self.germanVerbConjugationService.get_human_readable_grammar(self.morph)
        token_grammaticized = f'{infinitive} ({human_readable_grammar})'

        # Дублирующийся код с process_noun, подумать как избежать дубликации кода
        is_morph_form_absent_from_excel = not self.germanExcelService.is_morph_form_present(
            token_grammaticized)
        is_morph_form_absent_from_text_results_dict = token_grammaticized not in self.text_results_dict

        if is_morph_form_absent_from_excel and is_morph_form_absent_from_text_results_dict:
            conjugation = self.germanVerbConjugationService.get_verb_conjugation(infinitive, self.morph)
            translation = self.germanOOWriterService.get_word_translation(infinitive)
            # if human_readable_grammar == 'Partizip II':
            #     translation_with_grammar_hint = "{}^^^({})".format(translation, 'Infinitiv – Partizip II')
            # else:
            translation_with_grammar_hint = "{}^^^({})".format(translation, human_readable_grammar)

            result1 = token_grammaticized
            result2 = f'{conjugation}|{translation_with_grammar_hint}'
            # print(result1)
            # print(result2)
            # print('**************')

        return result1, result2


