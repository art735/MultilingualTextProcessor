from OOWriterOdtFileTableDao import OOWriterOdtFileTableDao, TableRowsToAnkiCardsMode


class VocabFileWordsPrinterIgnoringSentences:

    def __init__(self):
        self.ooWriterOdtFileTableDao = OOWriterOdtFileTableDao()

    def print_vocabulary(self):
        table_rows_as_anki_card_entities = self.ooWriterOdtFileTableDao.convert_table_rows_to_anki_cards(
            vocab_files=TableRowsToAnkiCardsMode.LAST_FILE)

        results = []
        for table_row_as_anki_card_entity in table_rows_as_anki_card_entities:
            result = table_row_as_anki_card_entity.to_str(format_type="front_transcription_back_with_comments")
            results.append(result)

        output = '\n'.join(results)
        return output


##################################################################

vocabFileWordsPrinterIgnoringSentences = VocabFileWordsPrinterIgnoringSentences()

res = vocabFileWordsPrinterIgnoringSentences.print_vocabulary()
print(res)

