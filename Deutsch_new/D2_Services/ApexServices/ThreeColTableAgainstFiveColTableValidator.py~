vocab_filename = r'E:\Languages\Deutsch\Goethe-Institut Wortliste\A1\[Vocab] Bb (part 2).odt'
portrait_filename = r'E:\Languages\Deutsch\Goethe-Institut Wortliste\A1\Bb (part 2) (portrait).odt'
portrait_filename = r'E:\Languages\Deutsch\Goethe-Institut Wortliste\A1\Cc-Dd (portrait).odt'

class ThreeColTableAgainstFiveColTableValidator:
    def __init__(self):
        self.ooWriterOdtFileTableDao = OOWriterOdtFileTableDao()

    def validate(self):
        vocab_table_rows_as_anki_card_entities = self.ooWriterOdtFileTableDao.convert_table_rows_to_anki_cards(
            vocab_files=TableRowsToAnkiCardsMode.ALL_FILES, ignore_sentences=False, ignore_empty_rows=False)

        non_matching_results_dict = {}
        cards_not_found_in_vocab_files = []
        portrait_table_rows_as_anki_card_entities = self._convert_3_col_cards_to_5_col_cards(portrait_filename)
        for portrait_card in portrait_table_rows_as_anki_card_entities:
            portrait_card_front_str = ';'.join(portrait_card.front)
            # 1. Проверяем, чтобы поле Front портретной карточки совпало с полем Front одной из vocab-карточек
            vocab_card = self._search_corresponding_vocab_card(portrait_card, vocab_table_rows_as_anki_card_entities)
            if vocab_card:
                portrait_card_str = portrait_card.to_str("front_transcription_back_with_comments")
                vocab_card_str = vocab_card.to_str("front_transcription_back_with_comments")

                non_matching_card_fields = []
                if vocab_card_str != portrait_card_str:
                    if portrait_card.front_comment != vocab_card.front_comment:
                        non_matching_card_fields.append('front_comment')

                    if portrait_card.transcription != vocab_card.transcription:
                        non_matching_card_fields.append('transcription')

                    if portrait_card.back != vocab_card.back:
                        non_matching_card_fields.append('back')

                    if portrait_card.back_comment != vocab_card.back_comment:
                        non_matching_card_fields.append('back_comment')

                    if len(non_matching_card_fields) > 0:
                        non_matching_results_dict[portrait_card_front_str] = ', '.join(non_matching_card_fields)
            else:
                cards_not_found_in_vocab_files.append(portrait_card_front_str)

        output = ''
        # Если какие-то портретные карточки не нашлись в vocab-файлах - это серьёзная ошибка, такого вообще быть
        # не должно. Выводим список этих ненайдёнышей и прекращаем валидацию.
        if cards_not_found_in_vocab_files:
            output += f'Cards not found in vocab files:\n'
            output += '\n'.join(cards_not_found_in_vocab_files)
        else:
            if non_matching_results_dict:
                output += f'The following rows in [Vocab]-file need to be corrected:\n'
                for card_front_str, non_matching_card_fields_str in non_matching_results_dict.items():
                    output += f'{card_front_str}: {non_matching_card_fields_str}\n'

            if not output:
                output = 'ok'

        return output

    def _convert_3_col_cards_to_5_col_cards(self, table_rows):
        table_rows_as_anki_card_entities = []

        table_rows = self.ooWriterOdtFileTableDao.read_single_file_all_tables_data(portrait_filename)
        for table_row in table_rows:
            front_tr, transcription_tr, back_tr = table_row.split('|')

            front_tr_parsed = self.ooWriterOdtFileTableDao.parse(front_tr)
            transcription_tr_parsed = self.ooWriterOdtFileTableDao.parse(transcription_tr)
            back_tr_parsed = self.ooWriterOdtFileTableDao.parse(back_tr)

            front, front_comment = self._split_into_front_and_front_comment(front_tr_parsed)
            transcription = transcription_tr_parsed  # каждое поле Anki-карточки - это список строк

            if '* * *' in back_tr_parsed:
                delimiter_index = back_tr_parsed.index('* * *')
                back = back_tr_parsed[:delimiter_index]
                back_comment = back_tr_parsed[delimiter_index + 1:]  # +1 потому что разделитель не включается в список поля Back_comment
            else:
                back = back_tr_parsed
                back_comment = []

            anki_card_entity = AnkiCardEntity(front, front_comment, [], [], transcription, [], back, back_comment)
            table_rows_as_anki_card_entities.append(anki_card_entity)

        return table_rows_as_anki_card_entities

    def _search_corresponding_vocab_card(self, portrait_card, vocab_cards):
        result = None
        for vocab_card in vocab_cards:
            if portrait_card.front == vocab_card.front:
                result = vocab_card
                break

        return result

    # Разбить список на два подсписка, начиная с элемента, начинающегося с '//' или '/*'
    def _split_into_front_and_front_comment(self, first_col_vals_list):

        for i, line in enumerate(first_col_vals_list):
            if line.startswith('//') or line.startswith('/*'):
                part1 = first_col_vals_list[:i]
                part2 = first_col_vals_list[i:]
                return part1, part2  # каждое поле Anki-карточки - это список строк

        # Если разделителя нет, вернуть список без изменений
        return first_col_vals_list, []



