    def evaluate(self, input_text):
        possibly_new_words = []
        lines = Utils.split_by(input_text, '\n')
        for line in lines:
            if self.germanOOWriterService.is_word_absent_from_vocabulary(line) and self.germanOOWriterService.is_word_absent_from_vocabulary(line.lower()):
                possibly_new_words.append(line)

        possibly_new_words_str = '\n'.join(possibly_new_words)

        a010_NewLemmasFinder = A010_NewLemmasFinder()
        result = a010_NewLemmasFinder.find_new_lemmas(possibly_new_words_str, False,
                                                   False,
                                                   False,
                                                   False)
        return result


