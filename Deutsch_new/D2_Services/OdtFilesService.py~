import AnkiSearcher
import AppContext
from FilenameUtils import FilenameUtils
from OdtFileTableDao import OdtFileTableDao, TableRowsToAnkiCardsMode


# TODO: подумать над валидацией данных из [vocab]-файлов
# Преобразовывает вычитанные из [vocab]-файлов данные в Anki-карточки для последующего поиска среди них,
# валидации и т. д.
# Данный класс-сервис должен обязательно инициализироваться в МЕТОДЕ вызывающего класса, но не в его конструкторе!
# Это нужно для того, чтобы при каждом использовании данного класса дао-данные были максимально актуальными!
class OdtFilesService:

    def __init__(self):
        self.filenameUtils = FilenameUtils()
        self.odtFileTableDao = OdtFileTableDao()
        # words
        self.all_words_as_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards()

        # sentences
        self.all_vocab_files_sentences_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards(
            read_words=False, read_sentences=True)
        self.last_vocab_file_sentences_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards(
            vocab_files=TableRowsToAnkiCardsMode.LAST_FILE, read_words=False, read_sentences=True)

    def get_word_transcription(self, word_to_search):
        transcription = ''
        # Инициализируем перед каждым использованием, чтобы работать с актуальными данными

        found_card = self.get_word_entity(word_to_search)
        if found_card:
            transcription = found_card.transcription[-1]
            transcription = transcription.replace('\n', '^^^')
        return transcription

    def get_word_translation(self, word_to_search):
        translation = ''
        # # Инициализируем перед каждым использованием, чтобы работать с актуальными данными
        # table_rows_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards()
        found_card = self.get_word_entity(word_to_search)
        if found_card:
            translation = found_card.back[-1]
            translation = translation.replace('\n', '^^^')
        return translation

    def get_word_entity(self, word_to_search):
        found_card = AnkiSearcher.search_for_anki_card(word_to_search, self.all_words_as_entities)
        return found_card

    def is_word_absent_from_vocabulary(self, word_to_search):
        result = not self.is_word_in_vocabulary(word_to_search)
        return result

    def is_word_in_vocabulary(self, word_to_search):
        result = False
        # Инициализируем перед каждым использованием, чтобы работать с актуальными данными
        # table_rows_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards()
        found_card = AnkiSearcher.search_for_anki_card(word_to_search, self.all_words_as_entities)
        if found_card:
            result = True
        return result

    def is_word_absent_from_vocabulary_of_all_files_but_last(self, word_to_search):
        result = not self.is_word_in_vocabulary_of_all_files_but_last(word_to_search)
        return result

    def is_word_in_vocabulary_of_all_files_but_last(self, word_to_search):
        result = False
        table_rows_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards(
            vocab_files=TableRowsToAnkiCardsMode.ALL_FILES_BUT_LAST)
        found_card = AnkiSearcher.search_for_anki_card(word_to_search, table_rows_as_anki_card_entities)
        if found_card:
            result = True
        return result

    def find_sentence_in_vocabulary(self, sentence_to_search):
        result = ''
        # table_rows_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards(
        #     read_sentences=False)
        found_card = AnkiSearcher.search_for_anki_card(sentence_to_search,
                                                       self.all_vocab_files_sentences_as_anki_card_entities)
        if found_card:
            result = found_card.to_str(format_type="front_transcription_back")
        return result

    # Данный метод возвращает список предложений из всех [Vocab]-файлов.
    # Такой список предложений нужен на самом первом этапе работы программы для того, чтобы алгоритм мог сразу
    # игнорировать те предложения, которые уже ранее обрабатывались и:
    # 1) не тратить дорогое spaCy-время на их повторную обработку;
    # 2) не засорять ими результат обработки текущей порции предложений.
    def get_sentences_from_all_vocab_files(self):
        sentences = [entity.front[-1] for entity in self.all_vocab_files_sentences_as_anki_card_entities]
        return sentences

    def get_sentences_from_last_vocab_file(self):
        sentences = [entity.front[-1] for entity in self.last_vocab_file_sentences_as_anki_card_entities]
        return sentences

    def get_word_count_for_gui_title(self):
        no_of_vocab_files = len(self.filenameUtils.get_all_vocab_filenames())
        # table_rows_as_anki_card_entities = self.odtFileTableDao.convert_table_rows_to_anki_cards()
        word_count = len(self.all_words_as_entities)
        # f'{value:,}' (print value using commas as a thousand separators)
        language = AppContext.get_current_language()
        title = f'{language} Processor ([Vocab]-files: {no_of_vocab_files}; words: {word_count:,})'
        return title

    def print_len(self):
        print(len(self.all_words_as_entities))
        print(len(self.all_vocab_files_sentences_as_anki_card_entities))
        print(len(self.last_vocab_file_sentences_as_anki_card_entities))


