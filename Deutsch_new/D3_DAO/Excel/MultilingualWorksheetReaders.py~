class MultilingualFirstThreeColumnsWorksheetReader(BaseWorksheetReader):  # наследуется от BaseWorksheetReader

    def __init__(self):
        columns_dict = {
            0: 'FIRST_COLUMN_INDEX',
            1: 'SECOND_COLUMN_INDEX',
            2: 'THIRD_COLUMN_INDEX',
        }
        super().__init__(columns_dict)

    def get_data_from_worksheet(self, worksheet):
        sheet_data = super().get_data_from_worksheet(worksheet)
        results = []
        for row in sheet_data:
            token_grammaticized = row[0].strip()
            inflections = row[1].strip()
            grammar_hint = row[2].strip()
            # Игнорируем "шапку" таблицы
            if token_grammaticized == 'Токен с грамматикой' and inflections == 'Словоформы' and \
                    grammar_hint == 'Грамматическая подсказка':
                continue

            # token_grammaticized должен обязательно присутствовать, остальные 2 столбца могут отсутствовать (в
            # зависимости от части речи)
            if token_grammaticized:
                piped_row = f'{token_grammaticized}|{inflections}|{grammar_hint}'
                result = (token_grammaticized, piped_row)
                results.append(result)

        return results


