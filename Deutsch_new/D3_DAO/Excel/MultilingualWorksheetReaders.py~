from Base.BaseWorksheetReader import BaseWorksheetReader
from GermanVocabularyEntity import GermanVocabularyEntity

class MultilingualFirstColumnWorksheetReader(BaseWorksheetReader):  # наследуется от BaseWorksheetReader

    def __init__(self):
        columns_dict = {
            0: 'FIRST_COLUMN_INDEX',
        }
        super().__init__(columns_dict)

    def get_data_from_worksheet(self, worksheet):
        sheet_data = super().get_data_from_worksheet(worksheet)
        results = []
        for row in sheet_data:
            word = row[0].strip()
            # Игнорируем "шапку" таблицы
            if word == 'Ignored token':
                continue

            if word:  # берём в дальнейшую работу только непустые строки
                results.append(word)

        return results


