class MultilingualFirstTwoColumnsWorksheetReader(BaseWorksheetReader):  # наследуется от BaseWorksheetReader

    def __init__(self):
        columns_dict = {
            0: 'FIRST_COLUMN_INDEX',
            1: 'SECOND_COLUMN_INDEX',
        }
        super().__init__(columns_dict)

    def get_data_from_worksheet(self, worksheet):
        sheet_data = super().get_data_from_worksheet(worksheet)
        results = []
        for row in sheet_data:
            token = row[0].strip()
            lemma = row[1].strip()
            # Игнорируем "шапку" таблицы
            if token == 'Sentence token' and lemma == 'Manual lemma':
                continue

            if token and lemma:  # берём в дальнейшую работу только непустые строки
                result = (token, lemma)
                results.append(result)

        return results


