    def _get_ar_and_compare_it_to_er(self, input: list, expected_result):
        actual_result = []
        for item in input:
            ar = item
            # Вызываем бизнес-метод несколько раз подряд, чтобы убедиться, что его повторные вызовы ничего не меняют
            # в уже сформировавшемся при первом вызове результате.
            for i in range(0, 3):
                ar = self.greekPronunciationUnderliner2.underline_sequences(ar)
            actual_result.append(ar)
        self.assertEqual(expected_result, actual_result)
