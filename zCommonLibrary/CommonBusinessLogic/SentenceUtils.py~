# Регулярное выражение, целиком состоящее из lookarounds, просто указывает на позицию, в которой выполняются все
# заданные условия. Такой подход удобно использовать при поиске позиций для разбиения строки (например, для разбиения
# текста на отдельные предложения).
def split_into_sentences(text):

    # Заменить в тексте 2 и более подряд идущих пробелов на один пробел
    text = re.sub(' {2,}', f'{SPACE}', text)

    # 1. (?<!\w\.\w\.)
    # Negative lookbehind — проверяет, что перед текущей позицией не стоит аббревиатура вроде U.S. или e.g.:
    # \w\.\w\. означает: буква, точка, буква, точка
    # Примеры: U.S., e.g., A.B.
    # Назначение: исключить такие случаи, чтобы не считать точку после таких сокращений концом предложения.
    # 2. (?<![A-Z][a-z]\.)
    # Negative lookbehind — проверяет, что перед текущей позицией не стоит сокращение, например Mr., Dr., Ms.:
    # [A-Z][a-z]\. — заглавная + строчная буква + точка
    # Примеры: Mr., Dr., Ms., St.
    # Назначение: тоже не считать точку после таких сокращений концом предложения.
    # 3. (?<=[.?!…])
    # POSITIVE lookbehind — убеждается, что перед текущей позицией стоит один из знаков конца предложения.
    lookbehind = r'(?<!\w\.\w\.)(?<![A-Z][a-z]\.)(?<=[.?!…])'

    quotes = r'"\'„“«»›‹”‚‘”’'
    quotes_class_optional = f'[{quotes}]*'

    # обязательный пробел между предложениями + возможная открывающая кавычка + начало следующего предложения с большой
    # буквы
    lookahead = fr'(?=\s{quotes_class_optional}[A-ZÄÖÜЁ])'

    pattern = (
            lookbehind +
            quotes_class_optional +  # возможная кавычка в конце предложения (после знака препинания)
            lookahead
    )

    sentence_split_re = re.compile(pattern)

    # Если бы регулярное выражение целиком состояло из lookbehind + lookahead, удобно было бы разбивать текст на
    # отдельные предложения с помощью re.split(). Но так как регулярное выражение предусматривает, что между
    # lookbehind и lookahead могут реальные символы текста (кавычки), re.split() здесь уже не подходит, т. к. он будет
    # закусывать те символы, которые окажутся им захваченными между lookbehind и lookahead.
    # Лучший способ здесь — использовать re.finditer() для поиска позиций, а затем вручную разбивать строку,
    # не теряя ни одного символа.

    # Ищем позиции границ
    positions = []
    for match in sentence_split_re.finditer(text):
        # Если средняя часть регулярного выражения ничего не захватывает, но регулярка вырождается в этом случае в
        # lookbehind + lookahead; тогда match.start() и match.end() найденной позиции в тексте будут совпадать.
        # Если же средняя часть регулярного выражения захватывает кавычку(-и) в конце предложения, то match.start() и
        # match.end() будут различаться на длину захваченной подстроки (как правило, на 1 позицию, но если вдруг в конце
        # предложения будет идти несколько кавычек подряд, то match.start() и match.end() будут отличаться на длину этой
        # захваченной подстроки).
        # В любом случае для дальнейшей разбивки текста важна позиция именно match.end().
        positions.append(match.end())

    # Добавляем к найденным позициям в середине текста позицию начала и конца всего текста
    positions = [0, *positions, len(text)]

    # Разбиваем текст вручную по найденным позициям
    sentences = []
    for start, end in zip(positions, positions[1:]):
        sentence = text[start:end].strip()
        sentences.append(sentence)

    return sentences

