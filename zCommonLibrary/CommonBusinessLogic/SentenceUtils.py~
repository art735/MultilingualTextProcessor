import re

from CharConstants import SPACE


# Проверяет, является ли строка предложением.
# Предложение может заканчиваться точкой, вопросительным или восклицательным знаком, а также кавычкой после этих
# знаков препинания.
def is_sentence(text):
    return bool(re.search(r'[.?!]["“]?$', text))


def is_not_sentence(text):
    return not is_sentence(text)


