import re

from CharConstants import OPEN_PARENTHESIS, SPACE, CLOSE_PARENTHESIS


class BaseRegExFinder:

    # Требования к конечному виду word_pattern:
    # 1) word_pattern НЕ должен быть обёрнут анкерами начала и конца строки: ^word_pattern$.
    # Использование метода re.fullmatch(...) обеспечивает такое поведение из коробки.
    # 2) если word_pattern содержит логическое ИЛИ (|) на самом верхнем уровне (word_pattern = "ab|c"),
    # то он целиком должен быть обёрнут в non-capturing group,
    # чтобы его дальнейшее оборачивание в анкеры начала и конца строки не привело к тому,
    # что ИЛИ-части примкнут к разным анкерам (отдельно левая часть ИЛИ-выражения к анкеру начала строки и
    # отдельно правая часть ИЛИ-выражения к анкеру конца строки) и целостность выражения будет утрачена.
    # Например, если word_pattern = "ab|c", то механическое оборачивание его в анкеры даст "^ab|c$",
    # а надо чтобы было "^(?:ab|c)$"

    def __init__(self, word_pattern):
        self.validate_word_pattern(word_pattern)
        self.word_pattern = word_pattern

    def validate_word_pattern(self, word_pattern: str):
        # Rule #1
        if word_pattern.startswith('^') or word_pattern.endswith('$'):
            raise ValueError("Invalid pattern format: pattern shouldn't be anchored with '^' or '$'."
                             " re.fullmatch(...) method should be used instead where such a behaviour is needed.")

        # Rule #2
        is_wrapped_in_a_non_capturing_group = word_pattern.startswith('(?:') and word_pattern.endswith(')')
        if not is_wrapped_in_a_non_capturing_group:
            raise ValueError("It is highly advisable that word_pattern be wrapped in a non-capturing group!")

    def find_all_language_specific_words(self, text):
        all_language_specific_words = re.findall(self.word_pattern, text)
        return all_language_specific_words

    def is_token_a_language_specific_word(self, token):
        result = False

        # позднейшая вставка
        is_equal_quantity_of_parentheses = token.count('(') == token.count(')')
        if not is_equal_quantity_of_parentheses:
            return False

        # Проверяет, что token полностью (от начала и до конца) соответствует регулярному выражению.
        match = re.fullmatch(self.word_pattern, token)
        if match:
            result = True
        return result

    # ----------------------------------------------------------
    # Маловероятно, что token, после всех процедур по отклеиванию от, например, греческого текста всего негреческого,
    # может содержать негреческие символы, но, тем не менее, данный метод перестраховывает ситуацию и из "грязного"
    # токена достаёт чистое греческое слово без примеси цифр, знаков препинания и пр.
    def search_token_for_language_specific_word(self, token):
        result = ''
        match = re.search(self.word_pattern, token)
        if match:
            result = match.group()
        return result

    def contains_language_specific_symbols(self, word):
        result = False
        search_res = self.search_token_for_language_specific_word(word)
        if search_res:
            result = True
        return result

    # ----------------------------------------------------------

    # "Окружить пробелами не-языко-специфичные вкрапления (inclusions)" - т. е. отлепить от языко-специфичных слов
    # цифры, скобки, пунктуацию и прочее - всё то, что потом бы помешало нормальной токенизации и лемматизации.

    # Создание инверсии регулярного выражения (т. е. нахождение всего, что не соответствует данному регулярному
    # выражению language_specific_word_pattern) может быть сложной задачей, поскольку регулярные выражения НЕ обладают
    # встроенной функцией инверсии.
    # Однако, можно воспользоваться некоторыми обходными методами для достижения аналогичного результата.
    # Один из подходов состоит в использовании функции re.split() для разделения текста на части,
    # которые соответствуют данному регулярному выражению, а затем работы с оставшимися частями.
    def surround_with_spaces_non_language_specific_inclusions(self, text):
        # Отклеить слово в скобках от окружающих его с обеих сторон скобок.
        result = self._unglue_parentheses_from_word_edges(text)

        # Разбиваем текст на части по регулярному выражению, соответствующему иностранному слову.
        # В результате получаем список текстовых фрагментов, НЕ соответствующих регулярному выражению, т. е.
        # НЕ являющихся иностранными словами. Это могут быть знаки препинания, цифры и т. д.
        # Если word_pattern обёрнут в regex-группу, она должна быть обязательно non-capturing,
        # иначе в non_matching_parts будут попадать и захваченные токены полезного текста.
        # word_pattern НЕ должен быть обёрнут анкерами начала строки (^) и конца строки ($)
        non_matching_parts = re.split(self.word_pattern, result)
        for non_matching_part in non_matching_parts:
            # работаем дальше с non_matching_part, если она НЕ является пустой строкой и пробелом
            if non_matching_part and non_matching_part.strip():
                # Замена строки на саму себя, окружённую пробелами, только если пробелов вокруг нет
                # result = re.sub(f'(?<! )({non_matching_part})(?! )', r' \g<0> ', text)

                # Замена строки на саму себя, окружённую пробелами
                result = result.replace(non_matching_part, f'{SPACE}{non_matching_part}{SPACE}')

        # Заменяем два и более пробела одним пробелом не для красоты, а для уменьшения количества символов в исходном
        # тексте с целью избежания возможной ошибки, связанной с ограничениями spaCy на максимальную длину
        # входного текста.
        result = re.sub(r' {2,}', SPACE, result)

        # Убираем пробелы в начале и конце текста
        result = result.strip()
        return result

    def _unglue_parentheses_from_word_edges(self, input_text):
        # Если немецкое слово встречается в круглых скобках, оно будет неправильно обрабатываться:
        # левая круглая скобка останется приклеенной к слову (как будто это скобка-часть слова), а правая круглая скобка
        # будет отклеена, т. к. немецкое слово в круглых скобках с обеих сторон не допускается регулярным выражением.
        # Препроцессим такую ситуацию следующим образом: разбиваем текст на токены по пробелу, находим слова в скобках
        # и отклеиваем скобки пробелами с обеих сторон.
        processed_tokens = []
        for token in input_text.split():
            # if re.match(r'^\(.*\)$', token):
            if token.startswith(OPEN_PARENTHESIS) and token.endswith(CLOSE_PARENTHESIS):
                token = token.replace(OPEN_PARENTHESIS, OPEN_PARENTHESIS + SPACE)
                token = token.replace(CLOSE_PARENTHESIS, SPACE + CLOSE_PARENTHESIS)
                # token = re.sub(r'^\(', r'\g<0> ', token)
                # token = re.sub(r'\)$', r' \g<0>', token)
                # Рекурсивно вызываем метод, чтобы отклеить скобки любой вложенности
                token = self._unglue_parentheses_from_word_edges(token)
            processed_tokens.append(token)

        preprocessed_text = SPACE.join(processed_tokens)
        return preprocessed_text
