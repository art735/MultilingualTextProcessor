class TextLinebreaksFixer:
    def __init__(self):
        pass

    def remove_unnecessary_newlines(self, text):
        """
        Убирает ненужные переносы строк из текста, сохраняя их только если:
        1) Строка заканчивается знаком конца предложения (точка, восклицательный знак, вопросительный знак)
        2) Следующая строка начинается с заглавной буквы

        Args:
            text (str): Исходный текст

        Returns:
            str: Текст с удаленными ненужными переносами строк
        """
        # Список знаков препинания, означающих конец предложения
        end_sentence_marks = ['.', '!', '?', '...', '."', '!"', '?"', '.»', '!»', '?»']

        # Для греческого языка в данный список ещё нужно добавлять ";" (как эквивалент вопр. знака)
        is_language_greek = True
        if is_language_greek:
            end_sentence_marks.append(';')

        lines = text.splitlines()
        result_lines = []
        current_line = ""

        for i in range(len(lines)):
            line = lines[i]

            # Обрабатываем пустые строки
            if not line.strip():
                if current_line:
                    result_lines.append(current_line)
                    current_line = ""
                result_lines.append("")
                continue

            # Проверяем, заканчивается ли строка знаком конца предложения
            ends_with_punctuation = False
            for mark in end_sentence_marks:
                if line.rstrip().endswith(mark):
                    ends_with_punctuation = True
                    break

            # Проверяем, начинается ли следующая строка с заглавной буквы
            next_starts_with_capital = False
            if i < len(lines) - 1 and lines[i + 1].strip():
                next_first_char = lines[i + 1].strip()[0]
                next_starts_with_capital = next_first_char.isalpha() and next_first_char.isupper()

            # Решаем, нужно ли сохранить перенос строки
            keep_newline = ends_with_punctuation or next_starts_with_capital

            if current_line:
                # Если у нас уже есть начатая строка, добавляем к ней текущую с пробелом
                current_line += " " + line.strip()
            else:
                # Иначе начинаем новую строку
                current_line = line.strip()

            # Если нужно сохранить перенос строки, добавляем текущую строку к результату
            if keep_newline:
                result_lines.append(current_line)
                current_line = ""

        # Не забываем добавить последнюю обрабатываемую строку, если она есть
        if current_line:
            result_lines.append(current_line)

        # Объединяем результат в текст с переносами строк
        return '\n'.join(result_lines)

