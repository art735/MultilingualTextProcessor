# Алгоритм:
# 1. Собрать все вхождения от всех регулярных выражений: сохранить пары (start, end).
# 2. Отсортировать эти интервалы по start.
# 3. Слить пересекающиеся и смежные интервалы, чтобы избежать дублирования.
# 4. Извлечь соответствующие подстроки из исходного текста по объединённым интервалам.
def merge_overlapping_matches(text, patterns):
    matches = []

    # Шаг 1: собираем все позиции совпадений
    for pattern in patterns:
        for match in re.finditer(pattern, text):
            matches.append((match.start(), match.end()))

    # Шаг 2: сортируем по началу совпадения
    matches.sort()

    # Шаг 3: объединяем пересекающиеся и смежные интервалы
    merged = []  # список списков вида [start, end]
    for start, end in matches:
        if not merged:
            merged.append([start, end])
        else:
            prev_start, prev_end = merged[-1]
            if start <= prev_end:  # есть пересечение или примыкание
                merged[-1][1] = max(prev_end, end)  # расширяем правую границу существующего интервала
            else:
                merged.append([start, end])

    # Шаг 4: получаем финальные подстроки
    substrings = [text[start:end] for start, end in merged]
    return substrings

