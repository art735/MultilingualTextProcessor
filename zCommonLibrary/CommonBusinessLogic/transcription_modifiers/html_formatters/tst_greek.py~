def underline_substrings(text, patterns):
    """
    Оборачивает указанные подстроки в теги <u></u>, если они еще не обернуты.

    Args:
        text (str): Исходный текст
        substrings (list): Список подстрок для обработки

    Returns:
        str: Текст с обернутыми подстроками
    """

    # Если пользователь метода по ошибке передаст в качестве параметра patterns строку, обернуть её в список
    if isinstance(patterns, str):
        patterns = [patterns]

    substrings = merge_overlapping_matches(text, patterns)


    # Сортируем подстроки по длине в порядке убывания,
    # чтобы сначала обрабатывать более длинные подстроки
    # (избегаем ошибок при вложенных подстроках)
    sorted_substrings = sorted(substrings, key=len, reverse=True)

    # Создаем временные маркеры для отслеживания уже обработанных частей текста
    processed_ranges = []

    result = text

    for substring in sorted_substrings:
        # Ищем все вхождения подстроки
        current_pos = 0
        while True:
            # Ищем следующее вхождение подстроки
            start_pos = result.find(substring, current_pos)
            if start_pos == -1:
                break

            end_pos = start_pos + len(substring)

            # Проверяем, не находится ли это вхождение уже внутри тегов <u></u>
            already_underlined = False

            # Ищем ближайший открывающий тег <u> перед текущей позицией
            u_start = result.rfind("<u>", 0, start_pos)
            if u_start != -1:
                # Ищем ближайший закрывающий тег </u> после открывающего тега
                u_end = result.find("</u>", u_start)
                # Если закрывающий тег существует и находится после конца подстроки,
                # значит подстрока уже внутри тегов подчеркивания
                if u_end != -1 and u_end >= end_pos:
                    already_underlined = True

            # Проверяем, не пересекается ли текущее вхождение с уже обработанными участками
            is_in_processed_range = False
            for p_start, p_end in processed_ranges:
                if (start_pos >= p_start and start_pos < p_end) or \
                        (end_pos > p_start and end_pos <= p_end) or \
                        (start_pos <= p_start and end_pos >= p_end):
                    is_in_processed_range = True
                    break

            # Если подстрока еще не подчеркнута и не пересекается с обработанными участками,
            # добавляем теги подчеркивания
            if not already_underlined and not is_in_processed_range:
                result = result[:start_pos] + "<u>" + result[start_pos:end_pos] + "</u>" + result[end_pos:]
                # Обновляем позицию поиска и добавляем в список обработанных участков
                current_pos = start_pos + len("<u>") + len(substring) + len("</u>")
                processed_ranges.append((start_pos, current_pos))
            else:
                # Если подстрока уже подчеркнута или пересекается, просто двигаемся дальше
                current_pos = end_pos

    return result


