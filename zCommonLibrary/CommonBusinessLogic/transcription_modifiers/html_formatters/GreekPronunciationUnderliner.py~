    def underline_sequences(self, html_str):
        patterns = GreekPronunciationPatternsHolder.get_patterns()
        result = self.underline_substrings(html_str, patterns)

        # result = self.underline_s_to_z_before_voiced(result)
        # result = self.underline_ni_plus_bp_dt_gk(result)
        #
        # # Palatalization
        # result = self.underline_palatalization1(result)
        # result = self.underline_palatalization2(result)
        # result = self.underline_palatalization31(result)
        # result = self.underline_palatalization32(result)

        # key - слово после отработки всех регулярок по подчёркиванию последовательностей
        # value - слово в том виде, в котором оно реально употребляется в языке
        exceptions_dict = {'<u>δια</u>γώ<u>νιο</u>ς': 'διαγώ<u>νι</u>ος',
                           '<u>διά</u>λεξη': 'διάλεξη',
                           '<u>βιο</u>λο<u>γί</u>α': 'βιολο<u>γί</u>α',
                           '<u>γυ</u>μνά<u>σιο</u>': '<u>γυ</u>μνάσιο',
                           'δωμά<u>τιο</u>': 'δωμάτιο',
                           'εμπ<u>όριο</u>': 'εμπόριο',
                           '<u>κι</u>βώ<u>τιο</u>': '<u>κι</u>βώτιο',
                           '<u>πιέ</u>ζω': 'πιέζω',
                           'τεράσ<u>τιο</u>': 'τεράστιο'
                           }

        # Корректируем подчёркивания для слов-исключений
        for k, v in exceptions_dict.items():
            if k in result:
                result = result.replace(k, v)

        return result



