VOWEL_SOUNDS = [
    "aɪ", "aʊ", "ɔɪ", "eɪ", "oɪ",  # Дифтонги
    "iː", "eː", "ɛː", "aː", "ɑː", "oː", "uː", "yː", "øː", "œː",  # Долгие гласные
    "i", "e", "ɛ", "a", "ɑ", "o", "u", "y", "ø", "œ", "ɔ",  # Короткие гласные
    "ɪ", "ʊ", "ʏ", "ɐ", "ə"  # Редуцированные и нейтральные
]

# Объединяем гласные звуки в одно регулярное выражение
PIPED_VOWEL_SOUNDS = "|".join(VOWEL_SOUNDS)
PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP = f'(?:{PIPED_VOWEL_SOUNDS})'

STRESS_SYMBOL = "ˈ"
GLOTTAL_STOP = "ʔ"

class GermanTranscriptionGlottalStopAppender:
    def __init__(self):
        self._stop = 'ˈ'

    # Функция для добавления гортанных смычек
    def add_glottal_stops(self, sentence_transcription):
        processed_word_transcriptions = []

        word_transcriptions = sentence_transcription[1:-1].split()
        for word_transcription in word_transcriptions:
            if self._needs_glottal_stop(word_transcription):
                # Гортанная смычка ставится в начале слова между знаком ударения и гласной
                if word_transcription.startswith(STRESS_SYMBOL):
                    result = f'{STRESS_SYMBOL}{GLOTTAL_STOP}{word_transcription[1:]}'
                else:
                    # Если подтвердится версия про то, что гортанную смычку ставим перед гласной без знака ударения при условии, что она в слове единственная
                    result = f'{GLOTTAL_STOP}{word_transcription}'
            else:
                result = word_transcription
            processed_word_transcriptions.append(result)

        merged_transcriptions = " ".join(processed_word_transcriptions)
        output = f'[{merged_transcriptions}]'

        return output

    def _needs_glottal_stop(self, word_transcription):
        result = False
        # Гортанная смычка нужна в следующих случаях:
        # 1) если слово начинается с ударной гласной (знак ударения + гласная: дифтонг или монофтонг)
        # 2) если слово начинается с гласной (дифтонг или монофтонг) и она в слове всего одна; знака ударения в слове нет
        if self._starts_with_stressed_vowel(word_transcription):  # or self._starts_with_vowel_and_has_exactly_one_vowel(word_transcription):
            result = True

        return result

    # Транскрипция слова начинается с гласного и:
    # 1) либо значок ударения явно присутствует и ударяет первый слог
    # 2) значок ударения отсутствует во всём слове (напр., [eːɐ̯ ])
    def _starts_with_stressed_vowel(self, word_transcription):
        result = False

        if STRESS_SYMBOL in word_transcription:
            pattern = rf"^{STRESS_SYMBOL}{PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP}"
            if re.match(pattern, word_transcription):
                result = True
        else:
            pattern = rf"^{PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP}"
            if re.match(pattern, word_transcription):
                result = True

        return result

