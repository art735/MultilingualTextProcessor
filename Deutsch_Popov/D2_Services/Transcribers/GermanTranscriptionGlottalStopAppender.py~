# Список всех гласных звуков и дифтонгов в немецком языке (IPA)
# Дифтонги в данном списке должны идти на первом месте, т. е. раньше монофтонгов: Это важно для алгоритма поиска слов,
# содержащих ровно один гласный звук.
# VOWEL_SOUNDS = [
#     "aɪ", "aʊ", "ɔɪ", "eɪ", "oɪ",  # Дифтонги
#     "iː", "eː", "ɛː", "aː", "ɑː", "oː", "uː", "yː", "øː", "œː",  # Долгие гласные
#     "i", "e", "ɛ", "a", "ɑ", "o", "u", "y", "ø", "œ", "ɔ",  # Короткие гласные
#     "ɪ", "ʊ", "ʏ", "ɐ", "ə"  # Редуцированные и нейтральные
# ]

# Отступы сделаны специально для максимального визуального соответствия реальной IPA-таблице
GERMAN_VOWEL_SOUNDS = [
    # Front         Central     Back
    'i', 'y',                   'u',
        'ɪ', 'ʏ',       'ʊ',
    'e', 'ø',                   'o',
                    'ə',
    'ɛ', 'œ',                   'ɔ',
                    'ɐ',
    'a'
]

# Объединяем гласные звуки в одно регулярное выражение
PIPED_VOWEL_SOUNDS = "|".join(GERMAN_VOWEL_SOUNDS)
PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP = f'(?:{PIPED_VOWEL_SOUNDS})'

STRESS_SYMBOL = "ˈ"
GLOTTAL_STOP = "ʔ"


# Основное правило: гортанная смычка ставится перед любой ударной гласной в начале слова.
class GermanTranscriptionGlottalStopAppender:

    # Функция для добавления гортанных смычек
    def add_glottal_stops(self, sentence_transcription):
        processed_word_transcriptions = []

        word_transcriptions = sentence_transcription[1:-1].split()
        for word_transcription in word_transcriptions:
            starts_with_stressed_vowel = bool(
                re.match(rf"^{STRESS_SYMBOL}{PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP}", word_transcription))
            starts_with_vowel = bool(re.match(rf"^{PIPED_VOWEL_SOUNDS_NON_CAPTURING_GROUP}", word_transcription))
            stress_is_absent = STRESS_SYMBOL not in word_transcription

            # Гортанная смычка ставится перед любой ударной гласной в начале слова.
            # Технически это значит, что слово начинается с гласной и наблюдается одно из двух явлений:
            # 1) "ударность гласной в начале слова" явно показана знаком ударения
            # 2) "ударность гласной в начале слова" вытекает из того, знак ударения в слове вообще отсутствует
            if starts_with_stressed_vowel:
                # Add glottal stop after stress symbol
                word_transcription = f'{STRESS_SYMBOL}{GLOTTAL_STOP}{word_transcription[1:]}'
            elif starts_with_vowel and stress_is_absent:
                # Add glottal stop before vowel
                word_transcription = f'{GLOTTAL_STOP}{word_transcription}'

            processed_word_transcriptions.append(word_transcription)

        output = f'[{" ".join(processed_word_transcriptions)}]'
        return output


