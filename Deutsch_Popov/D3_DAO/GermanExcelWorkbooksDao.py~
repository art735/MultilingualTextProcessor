base_folder = r'E:\Languages\English\SVN repo\Python software\MultilingualTextProcessor\resources\German'
deutsch_lexikon_popov_excel_filename = fr'{base_folder}\Deutsch Lexikon (!Popov).xls'
deutsch_lexikon_other_excel_filename = fr'{base_folder}\Deutsch Lexikon (other).xls'


# test_excel_filename = 'E:/Languages/English/SVN repo/Python software/MultilingualTextProcessor/resources/test.xls'


class GermanExcelWorkbooksDao:
    # Важно, чтобы данный список имён Excel-файлов был именно полем класса для удобства доступа из др. модулей и классов
    all_excel_filenames = [deutsch_lexikon_popov_excel_filename, deutsch_lexikon_other_excel_filename]
    # all_excel_filenames = [Politik_excel_filename]
    # all_excel_filenames = [deutsch_lexikon_popov_excel_filename]

    # VALIDATION_IGNORE_WORDS
    # sein - одновременно находится и в листе с глаголами, и в листе с прилагательными
    # ihr - одновременно находится и в листе с прилагательными, и в листе Other
    # sie - переводится и ОНА, и ОНИ, причём при склонении данных местоимений имеются отличия,
    # поэтому они являются двумя разными записями
    validation_ignore_words = ['sein', 'ihr', 'sie']

    def __init__(self):
        self.ALL_DATA_DICT = dict()
        self.slashContainingCellSplitter = SlashContainingCellSplitter()

    # Основной DAO-метод, который вызывается в бизнес-логике
    def get_data_as_dict(self):
        # Если поле ALL_DATA_DICT содержит данные, то их и использовать! Не дёргать каждый раз Excel-лист для чтения
        # данных! Метод reload_data_from_excel() обнуляет это поле (будучи повешенным на кнопку
        # "Reload data from Excel") и тогда Excel-лист будет прочитан заново.
        if len(self.ALL_DATA_DICT) > 0:
            return self.ALL_DATA_DICT

        # В методе вычитки данных первым пунктом должна идти валидация данных.
        # В данном случае производится валидация уникальности слов первого столбца, и если имеются дубликаты, будет
        # выброшен exception. Это самый лучший способ сообщить вызывающему коду о наличии проблемы.
        # TODO применить подобный подход в DAO-классах других проектов (для греч., англ. языков и т. д.)
        #  Устаревший подход ручного вызова какого-то метода валидации в бизнес-логике должен быть заменен на
        #  данный подход: ничего вручную вызывать (в вызывающем коде) не надо: классы вышестоящих уровней запрашивают
        #  у DAO данные и если с консистентностью данных что-то не так, exception извещает об наличии проблемы.
        self.validate_1st_col_words_uniqueness()

        all_articles_and_pronouns_wks_tuples = []
        all_bare_nouns_wks_tuples = []
        all_bare_adjectives_wks_tuples = []
        all_numerals_wks_tuples = []
        all_bare_verbs_wks_tuples = []
        all_other_wks_tuples = []

        for excel_filename in self.all_excel_filenames:
            workbook = xlrd.open_workbook(excel_filename)

            # На основании объекта КНИГИ файла Excel, сформировать объекты ЛИСТОВ файла Excel
            articles_and_pronouns_worksheet = workbook.sheet_by_name('Articles & Pronouns')
            nouns_worksheet = workbook.sheet_by_name('Nouns')
            adjectives_worksheet = workbook.sheet_by_name('Adjectives')
            numerals_worksheet = workbook.sheet_by_name('Numerals')
            verbs_worksheet = workbook.sheet_by_name('Verbs')
            other_worksheet = workbook.sheet_by_name('Other')

            # Вычитка данных с каждого Excel-листа в виде списка кортежей (word, transcription)
            articles_and_pronouns_wks_tuples = pos_reader_1_articles_and_pronouns_wks.get_tuples(
                articles_and_pronouns_worksheet)
            bare_nouns_wks_tuples = pos_reader_2_nouns_wks.get_tuples(nouns_worksheet)
            bare_adjectives_wks_tuples = pos_reader_3_adjectives_wks.get_tuples(adjectives_worksheet)
            numerals_wks_tuples = pos_reader_4_numerals_wks.get_tuples(numerals_worksheet)
            bare_verbs_wks_tuples = pos_reader_5_verbs_wks.get_tuples(verbs_worksheet)
            other_wks_tuples = pos_reader_6_other_wks.get_tuples(other_worksheet)

            all_articles_and_pronouns_wks_tuples.extend(articles_and_pronouns_wks_tuples)
            all_bare_nouns_wks_tuples.extend(bare_nouns_wks_tuples)
            all_bare_adjectives_wks_tuples.extend(bare_adjectives_wks_tuples)
            all_numerals_wks_tuples.extend(numerals_wks_tuples)
            all_bare_verbs_wks_tuples.extend(bare_verbs_wks_tuples)
            all_other_wks_tuples.extend(other_wks_tuples)

        # Объединить все данные в единый список
        tuples_from_all_sheets = []
        tuples_from_all_sheets.extend(all_articles_and_pronouns_wks_tuples)
        tuples_from_all_sheets.extend(all_bare_nouns_wks_tuples)
        tuples_from_all_sheets.extend(all_bare_adjectives_wks_tuples)
        tuples_from_all_sheets.extend(all_numerals_wks_tuples)
        tuples_from_all_sheets.extend(all_bare_verbs_wks_tuples)
        tuples_from_all_sheets.extend(all_other_wks_tuples)

        # Если кортеж (слово, транскрипция) содержит слеши, например, ("die Worte / die Wörter", "[ˈvɔʁtə] / [ˈvœʁtɐ]"),
        # то такой кортеж должен быть разбит по слешам на отдельные кортежи.
        # Для существительных данная логика отрабатывает раньше: она вызывается в модуле pos_reader_2_nouns_wks.py
        # до того, как будут стрипаться артикли. В противном случае, если вызывать её после стрипания артиклей, т. е.
        # например, здесь, то будет валидационная ошибка, т. к. у слова "die Worte / die Wörter" самый левый артикль
        # уже пострипан, а в правой части артикль остался, а это неконсистентность! Поэтому у существительных сплит по
        # слешу происходит до стрипания артиклей.
        # А вот у остальных частей речи, если вдруг где и встретится слеш, сплит происходит здесь.
        tuples_from_all_sheets = self.slashContainingCellSplitter.split_by_slash(tuples_from_all_sheets)

        # Конвертировать список кортежей (слово, транскрипция) в словарь {слово: транскрипция},
        # при этом дубликаты слов (или их форм) будут исключены сами собой (ключи словаря всегда уникальны)
        self.ALL_DATA_DICT = dict(Utils.convert_tuples_into_dictionary(tuples_from_all_sheets))

        # Если ячейка с транскрипцией содержит данные вида "[ˈkɛːzə], [ˈkeːzə]", то берём только ту транскрипцию,
        # которая стоит до первой запятой.
        self.preprocess_transcriptions()

        return self.ALL_DATA_DICT

    # Предварительная обработка транскрипций.
    # Если ячейка с транскрипцией содержит данные вида "[ˈkɛːzə], [ˈkeːzə]", то берём только ту транскрипцию,
    # которая стоит до первой запятой.
    def preprocess_transcriptions(self):
        for word, transcription in self.ALL_DATA_DICT.items():
            if ',' in transcription:
                self.ALL_DATA_DICT[word] = transcription.split(',')[0]
        return self.ALL_DATA_DICT

    def validate_1st_col_words_uniqueness(self):
        # key: excel_filename
        # value: list of 1st column words
        # Данные имеют именно такую структуру из-за того, что метод, их предоставляющий, вызывается ещё и в сценарии
        # формирования заголовка для главного окна GUI. Там такой формат данных важен, а здесь он легко преобразуется
        # в обычный список слов.
        words_per_excel_book_dict = self.get_excel_words_for_validation()

        all_words = list(itertools.chain.from_iterable(words_per_excel_book_dict.values()))
        is_valid, duplicates = ValidationUtils.validate_vocabulary_uniqueness(
            'German .xls files', all_words, self.validation_ignore_words)

        if not is_valid:
            duplicates_str = '\n'.join(duplicates)
            raise ValueError(f"DUPLICATES FOUND:\n{duplicates_str}")

    def get_excel_words_for_validation(self):
        # Произвести валидацию уникальности слов в ЛИСТАХ Excel-файла.
        # Параметром метода является список кортежей (worksheet_name, wordsToValidate_index)

        words_per_excel_book_dict = dict()

        for excel_filename in self.all_excel_filenames:
            tuples_to_validate = []
            workbook = xlrd.open_workbook(excel_filename)

            # На основании объекта КНИГИ файла Excel, сформировать объекты ЛИСТОВ файла Excel
            articles_and_pronouns_worksheet = workbook.sheet_by_name('Articles & Pronouns')
            nouns_worksheet = workbook.sheet_by_name('Nouns')
            adjectives_worksheet = workbook.sheet_by_name('Adjectives')
            numerals_worksheet = workbook.sheet_by_name('Numerals')
            verbs_worksheet = workbook.sheet_by_name('Verbs')
            other_worksheet = workbook.sheet_by_name('Other')

            # Вторым элементом кортежа является индекс столбца, из которого нужно брать слова для валидации уникальности
            articles_and_pronouns_tuple = (articles_and_pronouns_worksheet, 0)
            nouns_tuple = (nouns_worksheet, 0)
            adjectives_tuple = (adjectives_worksheet, 0)
            numerals_tuple = (numerals_worksheet, 1)
            verbs_tuple = (verbs_worksheet, 0)
            other_tuple = (other_worksheet, 0)

            tuples_to_validate.append(articles_and_pronouns_tuple)
            tuples_to_validate.append(nouns_tuple)
            tuples_to_validate.append(adjectives_tuple)
            tuples_to_validate.append(numerals_tuple)
            tuples_to_validate.append(verbs_tuple)
            tuples_to_validate.append(other_tuple)

            # Получаем список слов для валидации
            words_to_validate = ExcelDaoUtils.get_words_for_uniqueness_validation(tuples_to_validate)
            # Сохраняем слова в словарь, ключом которого является имя Excel-файла, из которого эти слова вычитаны.
            # Такая структура данных нужна формирования статистики в заголовке окна на UI.
            words_per_excel_book_dict[excel_filename] = words_to_validate

        return words_per_excel_book_dict

