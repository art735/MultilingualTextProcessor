import itertools

import ValidationUtils
from GermanExcelWorkbooksDao import GermanExcelWorkbooksDao

# sein - одновременно находится и в листе с глаголами, и в листе с прилагательными
# ihr - одновременно находится и в листе с прилагательными, и в листе Other
# sie - переводится и ОНА, и ОНИ, причём при склонении данных местоимений имеются отличия, поэтому они являются двумя разными записями
validation_ignore_words = ['sein', 'ihr', 'sie']


class GermanExcelDaoUniquenessValidator:
    def __init__(self):
        self.germanExcelWorkbooksDao = GermanExcelWorkbooksDao()

    def validate_excel_1st_col_words_uniqueness(self):
        # key: excel_filename
        # value: list of 1st column words
        words_per_excel_book_dict = self.germanExcelWorkbooksDao.get_excel_words_for_validation()

        # Шаг №1. Непосредственно валидация уникальности
        all_words = list(itertools.chain.from_iterable(words_per_excel_book_dict.values()))
        is_valid, duplicates = ValidationUtils.validate_vocabulary_uniqueness(
            'German .xls files', all_words, validation_ignore_words)

        if not is_valid:
            duplicates_str = '\n'.join(duplicates)
            raise ValueError(f"DUPLICATES FOUND:\n{duplicates_str}")


########################################

if __name__ == "__main__":
    germanExcelDaoUniquenessValidator = GermanExcelDaoUniquenessValidator()
    germanExcelDaoUniquenessValidator.validate_excel_1st_col_words_uniqueness()
