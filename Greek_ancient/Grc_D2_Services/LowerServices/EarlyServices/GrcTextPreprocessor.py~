from cltk.alphabet.grc import normalize_grc

from GrcRegExFinder import GrcRegExFinder


class GrcTextPreprocessor:

    def __init__(self):
        self.ancGrkRegExFinder = GrcRegExFinder()

    def preprocess(self, input_str):
        # добавил позже всего данную строку, посмотрим как оно будет работать
        normalized_text = normalize_grc(input_str)

        # отклеиваем от греческих слов возможно прилипшие к ним цифры/числа (напр., номера стихов Библии), скобки и прочее.
        # В результате получаем текст, в котором греческие элементы чётко отделены пробелами от негреческих.
        # Теперь такой текст легко токенизировать и лемматизировать.
        preprocessed_text = self.ancGrkRegExFinder.surround_with_spaces_non_greek_inclusions(normalized_text)

        # преобразуем все слова исходного текста к нижнему регистру
        preprocessed_text = preprocessed_text.lower()

        return preprocessed_text


#############################

if __name__ == '__main__':

    grcTextPreprocessor = GrcTextPreprocessor()

    input_text = "#1Ἀρχὴ τοῦ εὐαγγελίου Ἰησοῦ Χριστοῦ [υἱοῦ θεοῦ]."

    res = grcTextPreprocessor.preprocess(input_text)
    print(res)
