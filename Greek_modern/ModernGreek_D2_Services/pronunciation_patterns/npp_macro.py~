# -*- coding: utf-8 -*-
import re

# Здесь можно узнать код символа
# https://www.babelstone.co.uk/Unicode/whatisit.html
EN_DASH = "–"  # U+2013 : EN DASH
EM_DASH = "—"  # U+2014 : EM DASH
HORIZONTAL_BAR = "―"  # U+2015 : HORIZONTAL BAR {quotation dash}

from collections import OrderedDict

# В Python2 словарь - это неупорядоченная структура данных. Словари стали упорядоченными начиная с Python 3.7 (порядок
# вставки ключей в словарь стал гарантированно сохраняться).
# В Python2 упорядочить пары ключ-значение (в виде кортежей) можно с помощью OrderedDict.
# Поскольку Notepad++ и OpenOffice ориентированы именно на Python2 (2025 год), используем OrderedDict вместо обычного
# словаря.
find_and_replace_dict = OrderedDict([
    # Заменить табуляцию на пробел
    (r'\t', ' '),

    # Заменить 2 и более пробелов на один пробел
    (r'[ ]{2,}', ' '),

    # Заменить длинное тире, HORIZONTAL_BAR или "--" на обычное тире
    (r'|'.join([EM_DASH, HORIZONTAL_BAR, '--']), EN_DASH),

    # Заменить пробел-дефис-пробел на пробел–тире–пробел
    (r' - ', ' – '),

    # Удалить символ '*'
    (r'[*]', ''),

    # Удалить пробелы и другие символы (всего 6 вариантов [ \t\n\r\f\v]) по краям строк
    (r'^.*$', lambda m: m.group().strip()),
])


def make_replacements(text):
    # Определяем стиль строк: CRLF (\r\n), LF (\n), или CR (\r).
    # В Notepad++ используется именно CRLF и применение функции strip к строкам такого стиля закономерно
    # стрипает символ возврата каретки \r (как это и предполагается работой метода strip, удаляющего следующие символы:
    # [ \t\n\r\f\v]). Чтобы сохранить CRLF в конце Notepad++ строк, разбиваем текст на отдельные строки по разделителю,
    # обрабатываем их, и затем склеиваем обратно по тому же самому разделителю.
    if '\r\n' in text:
        line_ending = '\r\n'
    elif '\r' in text:
        line_ending = '\r'
    else:
        line_ending = '\n'

    # Разбиваем текст на отдельные строки
    lines = text.split(line_ending)
    for i in range(len(lines)):
        line = lines[i]

        for j in range(0, 1):  # кол-во прогонов всех замен для каждой строки. По умолчанию 1, можно делать 2.
            for pattern, replacement in find_and_replace_dict.items():
                # Если replacement — строка, она интерпретируется буквально, включая спецсимволы (\1, \g<name> и т. п.).
                # Если replacement — функция, она вызывается с объектом Match, и программист должен сам вернуть нужную строку.
                # print(pattern)
                line = re.sub(pattern, replacement, line)

        lines[i] = line

    # Объединить строки обратно с правильным разделителем
    text = line_ending.join(lines)
    return text

