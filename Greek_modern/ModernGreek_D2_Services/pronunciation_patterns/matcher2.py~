import re
import GreekPronunciationPatternsHolder


# ChatGPT prompt
# У меня есть пять сложных регулярных выражений, которые захватывают в тексте как непересекающиеся,
# так и пересекающиеся последовательности символов. Мне нужен алгоритм, который бы на выходе выдавал список
# захваченных этими регулярными выражениями последовательностей символов из текста (наподобие результата работы
# метода re.findall). При этом пересекающиеся последовательности символов не должны дублироваться:
# ab + bcd = abcd (а не abbcd)

class GreekPronunciationMatcher2:
    exceptions_dict = {
        'διάλεξη': ['διά'],
        'βιολογία': ['βιο'],
        'γυμνάσιο': ['σιο'],
        'δωμάτιο': ['τιο'],
        'εμπόριο': ['όριο'],
        'κιβώτιο': ['τιο'],
        'πιέζω': ['πιέ'],
        'τεράστιο': ['τιο'],
        'διαγώνιος': [(0, 3), 'νιο'],
    }

    def __init__(self):
        pass

    def find_intervals(self, text):
        # список списков вида [start, end]
        self.intervals = []

        palatalization_patterns = GreekPronunciationPatternsHolder.get_palatalization_patterns()
        self._merge_overlapping_matches(text, palatalization_patterns)

        # # TODO: откорректировать self.intervals с учётом того, что подстроки для слов из exceptions_dict не должны
        # #  входить в self.intervals. Для выполнения этой задачи некоторые интервалы придётся сузить, а другие просто удалить.
        self.process_invervals_for_exceptional_words(text)

        interword_patterns = GreekPronunciationPatternsHolder.get_interword_patterns()
        self._merge_overlapping_matches(text, interword_patterns)

        return self.intervals


    # Алгоритм:
    # 1. Собрать все вхождения от регулярных выражений: сохранить пары (start, end).
    # 2. Отсортировать эти интервалы по start.
    # 3. Слить пересекающиеся и смежные интервалы, чтобы избежать дублирования.
    # 4. Извлечь соответствующие подстроки из исходного текста по объединённым интервалам.
    def _merge_overlapping_matches(self, text, patterns):
        # Перекладываем захваченные ранее интервалы в список matches
        matches = list(self.intervals)
        self.intervals = []

        # Шаг 1: собираем все позиции совпадений
        for pattern in patterns:
            for match in re.finditer(pattern, text):
                matches.append([match.start(), match.end()])

        # Шаг 2: сортируем по началу совпадения
        matches.sort()

        # Шаг 3: объединяем пересекающиеся и смежные интервалы
        for start, end in matches:
            if not self.intervals:
                self.intervals.append([start, end])
            else:
                prev_start, prev_end = self.intervals[-1]
                if start <= prev_end:  # если есть пересечение или примыкание
                    self.intervals[-1][1] = max(prev_end, end)  # расширяем правую границу существующего интервала
                else:
                    self.intervals.append([start, end])

        # метод ничего не возвращает, он просто заполняет глобальный список интервалов

        # Из интервалов можно получить подстроки
        # substrings = [text[start:end] for start, end in self.intervals]
        # print(substrings)

    def process_invervals_for_exceptional_words(self, text):
        lowered_text = text.lower()
        for word, exclusions in self.exceptions_dict.items():
            for match in re.finditer(re.escape(word), lowered_text):
                word_start = match.start()
                for exclusion in exclusions:
                    if isinstance(exclusion, tuple):
                        ex_start, ex_end = exclusion
                        abs_start = word_start + ex_start
                        abs_end = word_start + ex_end
                    else:  # строка
                        rel_start = word.find(exclusion)
                        if rel_start == -1:
                            continue  # защита от ошибки
                        abs_start = word_start + rel_start
                        abs_end = abs_start + len(exclusion)

                    # Удаляем или корректируем перекрывающиеся интервалы
                    new_intervals = []
                    for start, end in self.intervals:
                        if end <= abs_start or start >= abs_end:
                            new_intervals.append([start, end])  # не пересекаются
                        elif start < abs_start and end > abs_end:
                            # исключение внутри интервала — разрезаем
                            new_intervals.append([start, abs_start])
                            new_intervals.append([abs_end, end])
                        elif start < abs_start < end <= abs_end:
                            # левая часть остаётся
                            new_intervals.append([start, abs_start])
                        elif abs_start <= start < abs_end < end:
                            # правая часть остаётся
                            new_intervals.append([abs_end, end])
                        # иначе — полностью внутри исключения: пропускаем
                    self.intervals = new_intervals


