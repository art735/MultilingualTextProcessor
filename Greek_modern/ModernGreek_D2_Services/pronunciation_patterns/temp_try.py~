import re

def remove_html_underlining(text, exceptions_dict):
    def process_word(html_word, exception_data):
        # Разбираем HTML на список: (символ, подчёркнут ли)
        positions = []
        pos = 0
        tag_re = re.compile(r'<u>(.*?)</u>')
        last_end = 0
        for match in tag_re.finditer(html_word):
            # добавим неподчёркнутую часть перед тегом
            before = html_word[last_end:match.start()]
            positions.extend((ch, False) for ch in before)
            underlined = match.group(1)
            positions.extend((ch, True) for ch in underlined)
            last_end = match.end()
        # добавим остаток
        after = html_word[last_end:]
        positions.extend((ch, False) for ch in after)

        chars = [c for c, _ in positions]
        flags = [f for _, f in positions]
        plain_word = ''.join(chars)

        # Применяем исключения
        for removal in exception_data:
            if isinstance(removal, str):
                start = 0
                while True:
                    idx = plain_word.find(removal, start)
                    if idx == -1:
                        break
                    for i in range(idx, idx + len(removal)):
                        flags[i] = False
                    start = idx + 1
            elif isinstance(removal, tuple) and len(removal) == 2:
                for i in range(removal[0], removal[1]):
                    if 0 <= i < len(flags):
                        flags[i] = False

        # Сборка HTML обратно
        result = ''
        i = 0
        while i < len(chars):
            if flags[i]:
                result += '<u>'
                while i < len(chars) and flags[i]:
                    result += chars[i]
                    i += 1
                result += '</u>'
            else:
                result += chars[i]
                i += 1
        return result

    # Ищем фрагменты с <u>…</u>
    def find_word_blocks(html):
        # Группируем всё, что выглядит как "одно слово", даже если состоит из частей с <u>
        pattern = re.compile(r'(?:<u>.*?</u>|[^<\s])+')
        return pattern.findall(html)

    result = ''
    last_pos = 0
    for word in find_word_blocks(text):
        plain_word = re.sub(r'</?u>', '', word)
        if plain_word in exceptions_dict:
            result += process_word(word, exceptions_dict[plain_word])
        else:
            result += word

    return result


