import ast

import FileContentsReader
from DictionaryAppearanceValidator import DictionaryAppearanceValidator

# TODO: сделать вычитку последнего файла
base_dir = r'E:\Languages\Greek\! Subtitles\Ευτυχισμένοι Μαζί'
filename = fr'{base_dir}\\pos & morph 01.txt'

txt_data = FileContentsReader.get_file_text(filename)
txt_data = txt_data.strip()  # Убирает по краям строки пробел и следующие символы [\t\n\r\v\f]

dictionaryAppearanceValidator = DictionaryAppearanceValidator()
if not dictionaryAppearanceValidator.validate_braces(txt_data):
    raise Exception(f"Braces mismatch in file '{filename}'")


# Преобразуем строку в словарь
dictionary = ast.literal_eval(txt_data)

print(dictionary)
print(type(dictionary))  # Убедимся, что это действительно словарь

