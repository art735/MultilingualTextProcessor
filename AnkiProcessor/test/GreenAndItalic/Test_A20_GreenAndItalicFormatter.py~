    def tc_20(self, business_method_callback):
        # Тестировать, что regex3 корректно отрабатывает захват более одного термина

        html_str = 'грам. лингв. перевод слова'
        expected_result = '<span style="color: rgb(0, 170, 0);"><i>грам. лингв.</i></span> перевод слова'
        actual_result = business_method_callback(html_str)
        self.assertEqual(expected_result, actual_result)

        html_str = 'грам., лингв. перевод слова'
        expected_result = '<span style="color: rgb(0, 170, 0);"><i>грам., лингв.</i></span> перевод слова'
        actual_result = business_method_callback(html_str)
        self.assertEqual(expected_result, actual_result)

        html_str = 'грам.; лингв. перевод слова'
        expected_result = '<span style="color: rgb(0, 170, 0);"><i>грам.; лингв.</i></span> перевод слова'
        actual_result = business_method_callback(html_str)
        self.assertEqual(expected_result, actual_result)

        # Использование недопустимого разделителя (?) приводит к тому, что каждый термин захватывается отдельно,
        # но вместе как единое целое они не захватываются
        html_str = 'грам.? лингв. перевод слова'
        expected_result = '<span style="color: rgb(0, 170, 0);"><i>грам.</i></span>? <span style="color: rgb(0, 170, 0);"><i>лингв.</i></span> перевод слова'
        actual_result = business_method_callback(html_str)
        self.assertEqual(expected_result, actual_result)

    def test_20(self):
        self.tc_19(self.c1_GreenAndItalicFormatter.format_green_and_italic)
        self.tc_19(self.greenAndItalicAggregator.execute_all_the_methods)

