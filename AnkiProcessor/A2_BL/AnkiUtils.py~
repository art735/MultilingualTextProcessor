import re
from datetime import datetime

import TimeUtils
from A3_DAO import AnkiConnectDao


def get_notes_by_deck_name(deck_name):
    # print("Inside 'getNotesByDeckName'...")
    notes_ids = AnkiConnectDao.invoke_anki_connect('findNotes', query=f'deck:"{deck_name}"')
    notes = AnkiConnectDao.invoke_anki_connect('notesInfo', notes=notes_ids)
    return notes


def get_all_notes_from_all_decks():
    print("START of getting notes from Anki at " + TimeUtils.get_current_timestamp())
    decks_with_notes_dict = dict()
    for deckName in AnkiConnectDao.invoke_anki_connect('deckNames'):
        notes = get_notes_by_deck_name(deckName)
        decks_with_notes_dict[deckName] = list(notes)

    print("END of getting notes from Anki at " + TimeUtils.get_current_timestamp())
    print("#######################")
    return decks_with_notes_dict


def reset_note_cards_to_new(note):
    # Получаем id-шники привязанных к note карточек
    card_ids = note["cards"]
    # Сбрасываем карточки
    AnkiConnectDao.invoke_anki_connect('forgetCards', cards=card_ids)


