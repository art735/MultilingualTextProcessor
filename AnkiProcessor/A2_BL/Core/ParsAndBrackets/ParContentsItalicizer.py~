from A0_CoreAnkiFormatter import A0_CoreAnkiFormatter
from BaseParsAndBracketsFormatter import BaseParsAndBracketsFormatter
from TextFomatter import TextFormatter


class ParContentsItalicizer(BaseParsAndBracketsFormatter):
    def __init__(self):
        opening_bracketing_symbol = '('
        closing_bracketing_symbol = ')'

        # a0_CoreAnkiFormatter = A0_CoreAnkiFormatter()
        textFormatter = TextFormatter()
        is_formatting_already_existent_cb = textFormatter.is_text_italic_recursive_upwards
        # process_tag_cb = a0_CoreAnkiFormatter.make_italic
        # process_tag_cb = lambda parent_tag, soup: parent_tag.wrap(soup.new_tag('i'))

        super().__init__(opening_bracketing_symbol, closing_bracketing_symbol,
                         is_formatting_already_existent_cb, self.process_tag_cb)

    def process_tag_cb(self, parent_tag, soup):
        try:
            return parent_tag.wrap(soup.new_tag('i'))
        except Exception as e:
            print(f"ParContentsItalicizer: {e}")
            # print(e)
            print(f'parent_tag: {parent_tag}\n')
            return parent_tag  # или другой фоллбэк

    # Принимает html-строку и список текстовых фрагментов в скобках (plain text) и делает (если нужно) содержимое
    # каждого фрагмента курсивом
    def italicize(self, html_str, pars_pairs):
        result = super().make_formatting(html_str, pars_pairs)
        return result


