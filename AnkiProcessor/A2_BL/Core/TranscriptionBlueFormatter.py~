from CharConstants import PIPE
from TextColorizer import TextColorizer

# Выделять в транскрипциях синим цветом следующие последовательности символов:
sequences_to_paint_blue = ['tr', 'ŋk']
search_regex = PIPE.join(sequences_to_paint_blue)


class TranscriptionLetterSequencesBlueFormatter:
    def __init__(self):
        self.textColorizer = TextColorizer()

    def format_blue(self, html_str):
        result = self.textColorizer.colorize_blue(html_str, search_regex)
        return result


